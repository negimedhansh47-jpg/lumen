{
  "name": "lumen-learn",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "vars": { "LLM_MODEL": "nvidia/nemotron-3.5-super-vl-120b-a12b", "DAILY_LLM_CAP": "1500" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lumen-db",
      "database_id": "38499967-fad8-4a74-a308-7b690d789722"
    }
  ]
}





